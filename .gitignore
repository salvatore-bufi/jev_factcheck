# Local credentials and Python environments
.env
.env.*
!.env.example
.aws/
.venv*/
venv/

# Python caches and local scratch files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.log
*.part
*.tmp
*.swp
*~
.DS_Store
.claude/

# Datasets are downloaded or copied locally, never committed (see dataset/README.md)
/dataset/*/
!/dataset/README.md

# Benchmark results: keep the small summaries, ignore the bulky per-row and telemetry files
/results/**/answers.jsonl
/results/**/batches.jsonl
/results/**/latency.jsonl
/results/**/throughput.jsonl
/results/**/telemetry.jsonl
/results/**/failures.jsonl
/results/**/*.lock

# Model-specific build outputs and weights
/models/factcg/cache/
/models/factcg/ckpt/*
!/models/factcg/ckpt/.gitkeep
/models/winnow-12b/src/
/models/winnow-12b/cuda-libs/
/models/winnow-12b/runtime/
/models/winnow-12b-bf16/model/

# Legacy Jev experiment: derived development pools and the old (untracked) per-model run caches
/legacy/data/tune.jsonl
/legacy/data/selection.jsonl
/legacy/results/*predictions.jsonl
!/legacy/results/test_predictions.jsonl
/legacy/results/validation_error_analysis/review_sample.jsonl
/legacy/results/validation_error_analysis/error_manifest.jsonl
/legacy/results_runs/
